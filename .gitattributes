# Binary files must never be line-ending converted.
*.db binary
*.db-shm binary
*.db-wal binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff binary
*.woff2 binary
*.safetensors binary
*.gz binary

# Built frontend assets are shipped as-is; a line-ending rewrite would change the bytes the
# demo actually serves and invalidate the hashed file names.
web/frontend/dist/** -text
